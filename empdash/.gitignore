# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env
*.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Large binary cache files only ────────────────────────────────────────────
data/cache/theme3/*.zip
data/cache/theme1/*.xlsx
data/cache/last_refresh.json

# ── Elasticity CSV dumps (derived from eta_matrices.npz) ─────────────────────
data/elasticity/csv/

# ── Large rawdata binaries ────────────────────────────────────────────────────
rawdata/*.zip
rawdata/*.pdf
rawdata/*.HAR
rawdata/PHK*.html

# ── Audit: derived CSV exports ───────────────────────────────────────────────
# Regenerate with: .venv/bin/python audit/scripts/export_dashboard_outputs.py
# Scripts and the workbook are tracked; the 83 derived CSVs are not.
audit/dashboard_export/

# ── Claude session files ──────────────────────────────────────────────────────
.claude/

# ── Streamlit ────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── R console history ─────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/

# ── File kunci Excel ─────────────────────────────────────────────────────────
~$*
