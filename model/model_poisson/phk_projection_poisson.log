.     *====================================================================
.     * Reconstruct lagged macroeconomic indicators
.     *====================================================================
. 
.     foreach L of global LAGS {
  2. 
.         foreach var of global TRIGGER {
  3. 
.             capture drop L`L'_`var'
  4. 
.             gen L`L'_`var' = L`L'.`var'
  5. 
.         }
  6. 
.     }
