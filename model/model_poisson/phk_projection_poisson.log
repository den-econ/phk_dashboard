. /********************************************************************************
>         3. MODEL COMPARISON
> ********************************************************************************/
. 
.         tempname results

. 
.         postfile `results' lag rmse mae using ///
>                 "$output/lag_selection.dta", replace

. 
.         foreach L of global LAGS {
  2. 
.             display "==================================================================="
  3.             display "Estimating Lag `L'"
  4.             display "==================================================================="
  5. 
.             local       trigger
  6. 
.             foreach v of global TRIGGER {
  7.                 local trigger `trigger' L`L'_`v'
  8.             }
  9. 
.             // Poisson regression
.             poisson  $OUTCOME $STRUCTURE `trigger' i.month i.prov_id if train == 1, ///
>                         vce(cluster prov_id)
 10. 
.             // Estimate prediction 
.             est         save    model_lag`L', replace
 11.             est         clear
 12. 
.             est         use     model_lag`L'
 13.             cap         drop    phk_hat
 14. 
.             predict phk_hat
 15.             //predict xb, xb
.             //gen       phk_hat = exp(xb)
. 
.             capture drop err sqerr abserr 
 16. 
.             gen         err     = phk_flow-phk_hat if valid == 1
 17.             gen         sqerr   = err^2 if valid == 1
 18.             gen         abserr  = abs(err) if valid == 1
 19. 
.             qui         summarize sqerr if valid == 1
 20.             scalar      RMSE    = sqrt(r(mean))
 21. 
.             quietly summarize abserr if valid == 1
 22.             scalar      MAE     = r(mean)
 23. 
.             post        `results'  (`L') (RMSE) (MAE)
 24. 
.             // Save results
.             preserve
 25. 
.             keep if valid == 1
 26.             keep        prov_id year month phk_flow phk_hat 
 27.                     
.             save        "$output/projection_L`L'.dta", replace
 28. 
.             restore
 29.         }
