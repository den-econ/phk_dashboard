>             region ///
>             time, ///
>             labels( ///
>                 "Training observations" ///
>                 "Validation observations" ///
>                 "Pseudo R-squared" ///
>                 "RMSE" ///
>                 "MAE" ///
>                 "Province FE" ///
>                 "Month FE") ///
>             fmt(%15.0fc %15.0fc %6.3f %9.3f %9.3f 0 0))

. 
.     local tableopt ///
>         keep($STRUCTURE L1_* L3_* L6_* L12_*) ///
