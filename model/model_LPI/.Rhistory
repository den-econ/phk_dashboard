if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
SERVICE_SECTORS <- c(
"emp_share_trade_pct_y", "emp_share_transport_pct_y", "emp_share_accom_food_pct_y",
"emp_share_info_comm_pct_y", "emp_share_finance_pct_y", "emp_share_real_estate_pct_y",
"emp_share_business_svc_pct_y", "emp_share_public_admin_pct_y", "emp_share_education_pct_y",
"emp_share_health_pct_y", "emp_share_other_svc_pct_y"
)
# Labor-intensive sectors (lit review): manufacturing, construction, transport,
# accommodation-&-food, business services.
LABOR_INTENSIVE_SECTORS <- c(
"emp_share_manuf_pct_y", "emp_share_construction_pct_y", "emp_share_transport_pct_y",
"emp_share_accom_food_pct_y", "emp_share_business_svc_pct_y"
)
derive_candidates <- function(dat, yr) {
y <- dat[dat$month == 1 & dat$year == yr, ]
y$employee_share <- 100 * y$lab_employee_count_y / y$lab_working_pop_y   # wage-worker share
y$bpjs_pu_share  <- 100 * y$bpjstk_active_pu_y  / y$lab_working_pop_y    # formal social-security coverage
y$services_share <- rowSums(y[, SERVICE_SECTORS], na.rm = TRUE)          # services employment share
y$labor_intensity<- rowSums(y[, LABOR_INTENSIVE_SECTORS])                # labor-intensive employment share
M <- data.frame(
formal_share    =  y$lab_formal_share_pct_y,    # % formal workers
contract_share  =  y$lab_contract_share_pct_y,  # % with written contract
employee_share  =  y$employee_share,            # wage/salaried worker share
manuf_share     =  y$emp_share_manuf_pct_y,     # manufacturing employment share
agri_share      = -y$emp_share_agri_pct_y,      # agriculture share, sign-flipped (low exposure)
workers_perfirm =  y$ind_workers_per_firm_y,    # avg manufacturing firm size
pmdn_share      =  y$ind_firms_pmdn_share_y,    # domestic-firm (PMDN) share
bpjs_pu_share   =  y$bpjs_pu_share,             # BPJS-TK wage-earner (PU) coverage
services_share  =  y$services_share,            # services employment share
labor_intensity =  y$labor_intensity            # labor-intensive employment share
)
rownames(M) <- y$province_name_std
