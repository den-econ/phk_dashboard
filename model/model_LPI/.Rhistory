}
# The full candidate set, and the FINAL selection (see Stage B rationale below).
FULL_VARS  <- c("formal_share", "contract_share", "employee_share", "manuf_share",
"agri_share", "workers_perfirm", "pmdn_share", "bpjs_pu_share",
"services_share", "labor_intensity")
FINAL_VARS <- c("formal_share", "bpjs_pu_share", "services_share", "manuf_share", "agri_share")
# -----------------------------------------------------------------------------
# 2. Fit PCA -> oriented PC1 loadings + scores. PC1 is oriented so `formal_share`
#    loads positive (=> higher score = more exposure). PCA does not require
#    pre-signed inputs; the agri sign-flip and this orientation are only for
#    interpretability.
# -----------------------------------------------------------------------------
fit_exposure_pca <- function(M) {
p <- prcomp(M, center = TRUE, scale. = TRUE)
for (k in seq_len(min(2, ncol(M)))) {
if (p$rotation["formal_share", k] < 0) { p$rotation[, k] <- -p$rotation[, k]; p$x[, k] <- -p$x[, k] }
}
list(loadings = p$rotation[, 1],
load2    = if (ncol(M) >= 2) p$rotation[, 2] else NULL,
scores   = setNames(p$x[, 1], rownames(M)),
var_expl = (p$sdev^2 / sum(p$sdev^2)))
}
d <- read.csv(MASTER, stringsAsFactors = FALSE)
# =============================================================================
# LPI — Component 1: Labor Exposure to Recorded PHK
# =============================================================================
# Layoff Pressure Index (LPI), Indonesia PHK Early-Warning Dashboard.
#
# WHAT THIS COMPONENT IS
#   An EXPOSURE / context axis: how large and formal each province's workforce
#   is, i.e. the pool of workers that CAN be formally recorded as laid off (PHK).
#   It is NOT a layoff-warning score. A high value (e.g. DKI Jakarta) means a
#   large formal, recordable workforce -- the denominator of potential recorded
#   PHK -- not that layoffs are imminent. Exposure is kept SEPARATE from the
#   pressure/warning components and is never summed into a warning score.
#
# METHOD (transparent, two stages)
#   Stage A — CANDIDATE PCA on the FULL original 10-variable set. Kept in the
#             code on purpose so the variable selection is fully reproducible.
#   Stage B — narrow to a FINAL 5-variable set via two documented filters
#             (off-axis + redundancy), then build the headline index (PC1).
#   Single-year cross-sectional PCA; PC1 = exposure score. Anchor year = 2023.
#
# GRAIN / ANCHOR
#   province-year. The master broadcasts annual (_y) values across 12 months, so
#   we collapse with month == 1. Anchor = 2023 -> 34 provinces (the 4 new Papua
#   DOB provinces have no 2023 Sakernas structural data and drop out).
#
# INPUT : data/clean/phk_master.csv   (one row = province x month, 2022-2025)
# OUTPUT: model/model_LPI/outputs/exposure_component1_2023_scores.csv  (final index)
#         model/model_LPI/outputs/exposure_component1_loadings.csv      (final 5 weights)
#         model/model_LPI/outputs/candidate_full_pca_loadings.csv       (ALL 10 + decision)
#
# Run from repo root:  Rscript model/model_LPI/01_lpi_component1_exposure.R
# =============================================================================
MASTER  <- "~/phk_dashboard/data/clean/phk_master.csv"
OUT_DIR <- "~/phk_dashboard/model/model_LPI/outputs"
ANCHOR  <- 2023
if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
# -----------------------------------------------------------------------------
# 0. Sector groupings used by the derived variables.
# -----------------------------------------------------------------------------
# Service sectors summed into `services_share`. na.rm = TRUE so a blank micro-
# sector share (e.g. real-estate employment in a small province) counts as 0
# rather than nulling the whole sum -- this keeps Gorontalo / Maluku Utara /
# Sulawesi Barat in the sample (34 provinces instead of 31).
SERVICE_SECTORS <- c(
"emp_share_trade_pct_y", "emp_share_transport_pct_y", "emp_share_accom_food_pct_y",
"emp_share_info_comm_pct_y", "emp_share_finance_pct_y", "emp_share_real_estate_pct_y",
"emp_share_business_svc_pct_y", "emp_share_public_admin_pct_y", "emp_share_education_pct_y",
"emp_share_health_pct_y", "emp_share_other_svc_pct_y"
)
# Labor-intensive sectors (lit review): manufacturing, construction, transport,
# accommodation-&-food, business services.
LABOR_INTENSIVE_SECTORS <- c(
"emp_share_manuf_pct_y", "emp_share_construction_pct_y", "emp_share_transport_pct_y",
"emp_share_accom_food_pct_y", "emp_share_business_svc_pct_y"
)
# -----------------------------------------------------------------------------
# 1. Derive ALL originally-considered candidate variables for a given year.
#    All ORIENTED so higher = more exposure. `agri_share` enters NEGATIVELY: a
#    large agri (informal-buffer) workforce = LOW formal exposure. Inputs are
#    shares / ratios only (intensity), so province SIZE does not dominate.
# -----------------------------------------------------------------------------
derive_candidates <- function(dat, yr) {
y <- dat[dat$month == 1 & dat$year == yr, ]
y$employee_share <- 100 * y$lab_employee_count_y / y$lab_working_pop_y   # wage-worker share
y$bpjs_pu_share  <- 100 * y$bpjstk_active_pu_y  / y$lab_working_pop_y    # formal social-security coverage
y$services_share <- rowSums(y[, SERVICE_SECTORS], na.rm = TRUE)          # services employment share
y$labor_intensity<- rowSums(y[, LABOR_INTENSIVE_SECTORS])                # labor-intensive employment share
M <- data.frame(
formal_share    =  y$lab_formal_share_pct_y,    # % formal workers
contract_share  =  y$lab_contract_share_pct_y,  # % with written contract
employee_share  =  y$employee_share,            # wage/salaried worker share
manuf_share     =  y$emp_share_manuf_pct_y,     # manufacturing employment share
agri_share      = -y$emp_share_agri_pct_y,      # agriculture share, sign-flipped (low exposure)
workers_perfirm =  y$ind_workers_per_firm_y,    # avg manufacturing firm size
pmdn_share      =  y$ind_firms_pmdn_share_y,    # domestic-firm (PMDN) share
bpjs_pu_share   =  y$bpjs_pu_share,             # BPJS-TK wage-earner (PU) coverage
services_share  =  y$services_share,            # services employment share
labor_intensity =  y$labor_intensity            # labor-intensive employment share
)
rownames(M) <- y$province_name_std
M
}
# The full candidate set, and the FINAL selection (see Stage B rationale below).
FULL_VARS  <- c("formal_share", "contract_share", "employee_share", "manuf_share",
"agri_share", "workers_perfirm", "pmdn_share", "bpjs_pu_share",
"services_share", "labor_intensity")
FINAL_VARS <- c("formal_share", "bpjs_pu_share", "services_share", "manuf_share", "agri_share")
# -----------------------------------------------------------------------------
# 2. Fit PCA -> oriented PC1 loadings + scores. PC1 is oriented so `formal_share`
#    loads positive (=> higher score = more exposure). PCA does not require
#    pre-signed inputs; the agri sign-flip and this orientation are only for
#    interpretability.
# -----------------------------------------------------------------------------
fit_exposure_pca <- function(M) {
p <- prcomp(M, center = TRUE, scale. = TRUE)
for (k in seq_len(min(2, ncol(M)))) {
if (p$rotation["formal_share", k] < 0) { p$rotation[, k] <- -p$rotation[, k]; p$x[, k] <- -p$x[, k] }
}
list(loadings = p$rotation[, 1],
load2    = if (ncol(M) >= 2) p$rotation[, 2] else NULL,
scores   = setNames(p$x[, 1], rownames(M)),
var_expl = (p$sdev^2 / sum(p$sdev^2)))
}
d <- read.csv(MASTER, stringsAsFactors = FALSE)
View(d)
cand <- derive_candidates(d, ANCHOR)
FULL <- cand[complete.cases(cand[, FULL_VARS]), FULL_VARS]
fitA <- fit_exposure_pca(FULL)
cat("================ STAGE A: FULL 10-variable candidate PCA ================\n")
cat(sprintf("N = %d provinces | PC1 = %.1f%%  PC2 = %.1f%%\n\n",
nrow(FULL), 100 * fitA$var_expl[1], 100 * fitA$var_expl[2]))
# redundancy correlations that justify dropping two on-axis duplicates
r_emp    <- cor(FULL$employee_share,  FULL$formal_share)
r_labint <- cor(FULL$labor_intensity, FULL$manuf_share)
# Two-filter decision, recorded per variable:
#   Filter 1 (off-axis)    : |PC1 loading| < 0.25  -> loads on PC2, not exposure
#   Filter 2 (redundancy)  : on-axis but duplicates an already-kept variable
decide <- function(v, l1) {
if (v %in% FINAL_VARS) return("KEEP")
if (abs(l1) < 0.25)    return("DROP: off-axis (loads on PC2, not exposure)")
if (v == "employee_share")  return(sprintf("DROP: duplicate of formal_share (r=%.2f)", r_emp))
if (v == "labor_intensity") return(sprintf("DROP: near-duplicate of manuf_share (r=%.2f)", r_labint))
"DROP"
}
candA <- data.frame(
variable    = names(fitA$loadings),
PC1_loading = round(as.numeric(fitA$loadings), 3),
PC2_loading = round(as.numeric(fitA$load2), 3),
decision    = vapply(seq_along(fitA$loadings),
function(i) decide(names(fitA$loadings)[i], fitA$loadings[i]), character(1)),
stringsAsFactors = FALSE
)
View(cand)
View(candA)
candA <- candA[order(-abs(candA$PC1_loading)), ]
print(candA, row.names = FALSE)
cat(sprintf("\nRedundancy checks: employee_share~formal_share r=%.2f ; labor_intensity~manuf_share r=%.2f\n",
r_emp, r_labint))
write.csv(candA, file.path(OUT_DIR, "candidate_full_pca_loadings.csv"), row.names = FALSE)
# =============================================================================
# STAGE B — FINAL 5-variable exposure index (headline)
# =============================================================================
FINAL <- cand[complete.cases(cand[, FINAL_VARS]), FINAL_VARS]
fitB  <- fit_exposure_pca(FINAL)
cat("\n================ STAGE B: FINAL 5-variable exposure index ================\n")
cat(sprintf("N = %d provinces | PC1 = %.1f%%  (PC2: %.1f%%)\n\n",
nrow(FINAL), 100 * fitB$var_expl[1], 100 * fitB$var_expl[2]))
cat("PC1 loadings (= exposure weights):\n"); print(round(fitB$loadings, 3))
# sanity: does trimming change the ranking? (compare on shared provinces)
shAB <- intersect(names(fitA$scores), names(fitB$scores))
cat(sprintf("\nRanking stability full-10 vs final-5: Spearman = %.3f (shared %d provinces)\n",
cor(fitA$scores[shAB], fitB$scores[shAB], method = "spearman"), length(shAB)))
# 0-100 min-max rescale for presentation
pc1     <- fitB$scores
expo100 <- 100 * (pc1 - min(pc1)) / (max(pc1) - min(pc1))
scores <- data.frame(province = names(pc1), year = ANCHOR,
exposure_pc1 = round(as.numeric(pc1), 4),
exposure_0_100 = round(as.numeric(expo100), 1), stringsAsFactors = FALSE)
scores <- scores[order(-scores$exposure_pc1), ]
scores$rank <- seq_len(nrow(scores))
scores <- scores[, c("rank", "province", "year", "exposure_pc1", "exposure_0_100")]
loadings <- data.frame(variable = names(fitB$loadings),
pc1_loading = round(as.numeric(fitB$loadings), 4),
orientation = c("+", "+", "+", "+", "- (sign-flipped: high agri = low exposure)"),
stringsAsFactors = FALSE)
write.csv(scores,   file.path(OUT_DIR, "exposure_component1_2023_scores.csv"), row.names = FALSE)
write.csv(loadings, file.path(OUT_DIR, "exposure_component1_loadings.csv"),    row.names = FALSE)
cat("\nFinal 2023 exposure ranking:\n"); print(scores, row.names = FALSE)
# =============================================================================
# 3. ROBUSTNESS CHECKS on the FINAL index (printed, not written).
#    (A) Leave-one-out: is the index driven by any single province (esp. DKI)?
#    (B) 2024 refit: are the loadings / ranking stable across years?
# =============================================================================
cat("\n================ ROBUSTNESS (final 5-var index) ================\n")
loo <- sapply(rownames(FINAL), function(pv)
max(abs(fit_exposure_pca(FINAL[setdiff(rownames(FINAL), pv), ])$loadings - fitB$loadings)))
cat(sprintf("(A) Leave-one-out loading change  mean = %.3f  max = %.3f\n", mean(loo), max(loo)))
fD <- fit_exposure_pca(FINAL[setdiff(rownames(FINAL), "DKI Jakarta"), ])
sh <- intersect(names(fitB$scores), names(fD$scores))
cat(sprintf("    Ranking Spearman, full vs DKI-dropped = %.4f (index is NOT DKI-driven)\n",
cor(fitB$scores[sh], fD$scores[sh], method = "spearman")))
cand24 <- derive_candidates(d, 2024)
FINAL24 <- cand24[complete.cases(cand24[, FINAL_VARS]), FINAL_VARS]
f24 <- fit_exposure_pca(FINAL24)
sh2 <- intersect(names(fitB$scores), names(f24$scores))
cat(sprintf("(B) 2024 refit: PC1 var = %.1f%%  loading-vector congruence(2023,2024) = %.3f\n",
100 * f24$var_expl[1], cor(fitB$loadings, f24$loadings)))
cat(sprintf("    Ranking Spearman 2023 vs 2024 = %.3f (shared %d provinces)\n",
cor(fitB$scores[sh2], f24$scores[sh2], method = "spearman"), length(sh2)))
print(round(data.frame(load_2023 = fitB$loadings, load_2024 = f24$loadings,
diff = f24$loadings - fitB$loadings), 3))
cat("\nDone.\n")
View(cand24)
